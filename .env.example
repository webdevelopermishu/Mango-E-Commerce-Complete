# =============================================================================
#  Environment configuration — copy to `.env` and fill in.  NEVER commit `.env`.
#  [REQUIRED] = the app refuses to start in production without it.
#  Everything else is optional; leave it empty to disable that integration.
# =============================================================================

# --- Core --------------------------------------------------------------------

# [REQUIRED] PostgreSQL connection string (PostgreSQL 15+ recommended).
DATABASE_URL=postgres://mango:CHANGE_ME_DB_PASSWORD@127.0.0.1:5432/mango_shop

# [REQUIRED] Long random secret (min 32 chars) used to sign sessions and private order links.
# Generate with:  openssl rand -base64 48
# Changing it logs everyone out and invalidates links in old order-confirmation emails.
PAYLOAD_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING

# [REQUIRED] The public URL of the site exactly as customers type it, without a trailing slash.
# Used for canonical URLs, sitemaps, payment callbacks AND the admin's CSRF check: the admin panel only
# accepts logins from this origin, so it must match the real domain (https://...).
NEXT_PUBLIC_SERVER_URL=https://www.example.com

# Max DB connections from this app (default 10).
DATABASE_POOL_MAX=10

# Dev convenience only: let Payload push schema changes without migrations. Ignored in production.
DATABASE_PUSH=false

# Prefix for order numbers, e.g. AK-261026-7KQ4M (default AK).
ORDER_PREFIX=AK

# Max image upload size in bytes (default 8 MB).
MAX_UPLOAD_BYTES=8388608
# Max video upload size in bytes (default 60 MB). Keep Nginx client_max_body_size a little above it.
MAX_VIDEO_UPLOAD_BYTES=62914560

# Set to true ONLY on staging servers to keep them out of search engines.
ROBOTS_DISALLOW_ALL=false

# --- Media storage ------------------------------------------------------------
# Default: files are stored on disk in MEDIA_DIR. On a VPS point this at a persistent directory
# OUTSIDE the app folder so redeploys never delete uploads, and include it in backups.
MEDIA_DIR=/var/lib/mango-shop/media

# Optional: S3-compatible object storage (AWS S3, Cloudflare R2, DigitalOcean Spaces, Backblaze B2, MinIO).
# When S3_BUCKET is set, new uploads go to the bucket instead of MEDIA_DIR.
S3_BUCKET=
S3_REGION=
# Endpoint for non-AWS providers, e.g. https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_PREFIX=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# true for MinIO and some other providers
S3_FORCE_PATH_STYLE=false
# Only needed if images are served directly from a public bucket/CDN hostname (comma-separated).
# Read at BUILD time — rebuild after changing.
MEDIA_PUBLIC_HOSTNAMES=

# --- Email notifications (optional) ------------------------------------------
# Without SMTP, order emails are skipped (logged to the console) — orders still work.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Where new-order alerts for the shop owner are sent.
ORDER_NOTIFICATION_EMAIL=

# --- Online payments (optional) ----------------------------------------------
# A gateway appears at checkout only when (a) all of its credentials below are set AND
# (b) it is switched on in Admin → Website Settings → Payments. Cash on delivery needs nothing here.
# Keep PAYMENTS_SANDBOX=true until the provider has approved your live merchant account.
PAYMENTS_SANDBOX=true

# SSLCommerz (cards, mobile banking, internet banking)
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=

# bKash Tokenized Checkout
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# Override only if bKash gives you a different API host.
BKASH_BASE_URL=

# Nagad
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
# PEM keys may be written on one line with literal \n between lines.
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=
NAGAD_BASE_URL=

# --- Process / server ---------------------------------------------------------
PORT=3000
# 127.0.0.1 behind Nginx (default). Use 0.0.0.0 inside Docker.
HOSTNAME=127.0.0.1

# --- Rarely needed --------------------------------------------------------------
# Allow the browser-based "create first user" screen (otherwise use `npm run create-admin`).
ALLOW_WEB_FIRST_USER=false
# Only for testing over plain HTTP: allow admin session cookies without HTTPS. Never in production.
INSECURE_COOKIES=false
# Seed only: WhatsApp number to pre-fill (with country code). Leave empty for real deployments.
SEED_WHATSAPP_NUMBER=
